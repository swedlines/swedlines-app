{
  "name": "swedlines",
  "version": "1.1.1",
  "private": true,
  "description": "Swedlines (swedlines.com): dual-language (sv/en) aggregator of Swedish news headlines with a static JSON API, RSS feeds, a headline stream, and a ticker.",
  "homepage": "https://swedlines.com",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "logo": "node scripts/export-logo.ts",
    "cover": "node scripts/export-cover.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.12.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/node": "^26.6.6",
    "fontkit": "^3.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
